# Copy to .env.local and fill in. Without a key the app runs in MOCK mode
# (canned streamed answers) so the UI can be built and demoed offline.
ANTHROPIC_API_KEY=

# Optional. Default is claude-opus-5-5. For a snappier demo try
# claude-sonnet-5-5 or claude-haiku-5-5.
ANTHROPIC_MODEL=claude-opus-5-5

# Optional: low | medium | high. Lower = faster answers. Default low.
ANTHROPIC_EFFORT=low

# Force mock mode even with a key (useful when venue WiFi dies mid-demo).
# MOCK_AI=1
